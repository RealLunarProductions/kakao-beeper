#!/bin/bash
# kakao-beeper: control script for the KakaoTalk -> Beeper bridge on macOS.
# Installed to ~/.local/bin by install.sh. Written for macOS's stock bash 3.2.
set -euo pipefail

DATA="${KAKAO_BEEPER_DATA:-$HOME/.local/share/kakao-beeper}"
APP="$DATA/app"
LABEL="com.kakao-beeper.bridge"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"
BRIDGE_NAME="sh-kakaotalk"
BOT="@sh-kakaotalkbot:beeper.local"
BBCTL="$APP/bin/bbctl"
KAKAO_CREDS="$HOME/.config/agent-messenger/kakaotalk-credentials.json"

say() { printf '%s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[ -d "$APP" ] || die "not installed ($APP is missing). Run install.sh first."
NODE="$(cat "$APP/node-path" 2>/dev/null || true)"
[ -x "$NODE" ] || die "node not found (expected the path in $APP/node-path). Re-run install.sh."
KAKAO_CLI="$APP/sidecar/node_modules/agent-messenger/dist/src/platforms/kakaotalk/cli.js"

ask_yes() { # ask_yes "question" default(y|n)
    local reply
    if [ "$2" = y ]; then read -r -p "$1 [Y/n] " reply || reply=""; case "$reply" in [nN]*) return 1 ;; *) return 0 ;; esac
    else read -r -p "$1 [y/N] " reply || reply=""; case "$reply" in [yY]*) return 0 ;; *) return 1 ;; esac; fi
}

kakao_logged_in() { "$NODE" "$KAKAO_CLI" auth status >/dev/null 2>&1; }
beeper_logged_in() { "$BBCTL" whoami 2>&1 | grep -q '^User ID:'; }
service_loaded() { launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; }

cmd_login_kakao() {
    say "== KakaoTalk login"
    say "This signs in as a *tablet* device (like a second iPad/Android tablet). Your phone and"
    say "the KakaoTalk Mac app stay signed in. If you already use KakaoTalk on a tablet, that"
    say "tablet will be signed out. Your password stays in this terminal."
    say ""
    "$NODE" "$KAKAO_CLI" auth login --device-type tablet
    # A fresh login must replace the bridge's own copy of the credentials.
    rm -f "$DATA/agent-messenger/kakaotalk-credentials.json"
}

cmd_login_beeper() {
    say "== Beeper login (bbctl)"
    "$BBCTL" login
    beeper_logged_in || die "bbctl login did not complete."
}

cmd_configure() {
    mkdir -p "$DATA" && cd "$DATA"
    # A config generated by bbctl targets Beeper's hungryserv; move anything else aside.
    if [ -f config.yaml ] && ! grep -q 'software: hungry' config.yaml; then
        local broken
        broken="config.yaml.broken-$(date +%Y%m%d-%H%M%S)"
        say "config.yaml isn't a Beeper config; moving it to $broken"
        mv config.yaml "$broken"
    fi
    if [ ! -f config.yaml ]; then
        say "== Registering $BRIDGE_NAME with Beeper"
        # bbctl wants all flags before the bridge name.
        "$BBCTL" config --type bridgev2 -o config.yaml.new "$BRIDGE_NAME"
        grep -q 'software: hungry' config.yaml.new 2>/dev/null || { rm -f config.yaml.new; die "bbctl did not produce a Beeper config."; }
        mv config.yaml.new config.yaml
    fi
    if ! grep -q '^network:' config.yaml; then
        cat >>config.yaml <<EOF

# Network-specific config options
network:
    node_path: $NODE
    sidecar_script: $APP/sidecar/sidecar.mjs
    state_dir: $DATA/agent-messenger
    initial_backfill: 30
EOF
    fi
    chmod 600 config.yaml
}

write_plist() {
    mkdir -p "$HOME/Library/LaunchAgents" "$DATA/logs"
    cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$APP/bin/mautrix-kakaotalk</string>
        <string>-c</string>
        <string>config.yaml</string>
    </array>
    <key>WorkingDirectory</key><string>$DATA</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <key>ThrottleInterval</key><integer>15</integer>
    <key>ProcessType</key><string>Background</string>
    <key>StandardOutPath</key><string>/dev/null</string>
    <key>StandardErrorPath</key><string>$DATA/logs/launchd-stderr.log</string>
</dict>
</plist>
EOF
}

cmd_enable() {
    [ -f "$DATA/config.yaml" ] || die "no bridge config yet. Run: kakao-beeper setup"
    write_plist
    service_loaded && launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
    launchctl bootstrap "$DOMAIN" "$PLIST"
    launchctl kickstart -k "$DOMAIN/$LABEL" 2>/dev/null || true
    say "Bridge started; it will start again at every login."
}

cmd_disable() {
    service_loaded && launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
    rm -f "$PLIST"
    say "Bridge stopped and its login item removed."
}

cmd_start() { [ -f "$PLIST" ] || die "not enabled. Run: kakao-beeper setup"; service_loaded || launchctl bootstrap "$DOMAIN" "$PLIST"; launchctl kickstart "$DOMAIN/$LABEL"; say "started"; }
cmd_stop() { service_loaded && launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true; say "stopped (it starts again at next login; 'kakao-beeper disable' removes that)"; }
cmd_restart() { [ -f "$PLIST" ] || die "not enabled. Run: kakao-beeper setup"; service_loaded || launchctl bootstrap "$DOMAIN" "$PLIST"; launchctl kickstart -k "$DOMAIN/$LABEL"; say "restarted"; }

# Last bridge state the bridge sent to Beeper, from the JSON log: "CONNECTED",
# "TRANSIENT_DISCONNECT (kakao-disconnected)", "BAD_CREDENTIALS (kakao-login-failed)"...
session_state() {
    [ -f "$DATA/logs/bridge.log" ] || return 0
    local last ev er
    last="$(grep '"bridge_state"' "$DATA/logs/bridge.log" | tail -n 1)"
    [ -n "$last" ] || return 0
    ev="$(printf '%s' "$last" | grep -o '"state_event":"[A-Za-z_]*"' | tail -n 1 | cut -d'"' -f4)"
    er="$(printf '%s' "$last" | grep -o '"error":"[a-z-]*"' | head -n 1 | cut -d'"' -f4)"
    printf '%s%s' "${ev:-unknown}" "${er:+ ($er)}"
}

cmd_status() {
    if service_loaded; then
        launchctl print "$DOMAIN/$LABEL" | grep -E '^[[:space:]]*(state|pid|last exit code|runs) =' || true
    else
        say "bridge: not loaded"
    fi
    local st
    st="$(session_state)"
    [ -n "$st" ] && say "KakaoTalk session: $st"
    kakao_logged_in && say "KakaoTalk: signed in" || say "KakaoTalk: not signed in (kakao-beeper login-kakao)"
    beeper_logged_in && say "Beeper (bbctl): signed in" || say "Beeper (bbctl): not signed in (kakao-beeper login-beeper)"
    if [ -f "$DATA/logs/bridge.log" ]; then
        say ""; say "last log lines:"; tail -n 5 "$DATA/logs/bridge.log" | cut -c1-220
    fi
}

# Checks every link of the chain and prints OK/FAIL per line; exits 1 if anything failed.
cmd_doctor() {
    local fails=0
    ok() { say "  OK    $1"; }
    bad() { say "  FAIL  $1"; fails=$((fails + 1)); }
    say "kakao-beeper doctor"
    say "  macOS $(sw_vers -productVersion 2>/dev/null || echo '?'), $(uname -m), data in $DATA"

    if "$NODE" --version >/dev/null 2>&1; then ok "node runs: $NODE ($("$NODE" --version))"; else bad "node does not run: $NODE (re-run install.sh)"; fi
    if (cd "$APP/sidecar" 2>/dev/null && "$NODE" --input-type=module -e "await import('agent-messenger/kakaotalk')" 2>/dev/null); then
        ok "sidecar packages import"
    else bad "sidecar packages missing or broken (re-run install.sh)"; fi
    if "$APP/bin/mautrix-kakaotalk" --version >/dev/null 2>&1; then ok "bridge binary runs ($("$APP/bin/mautrix-kakaotalk" --version 2>/dev/null | head -n 1))"
    else bad "bridge binary does not run: $APP/bin/mautrix-kakaotalk (wrong CPU type or Gatekeeper; re-run install.sh)"; fi
    if "$BBCTL" --version >/dev/null 2>&1; then ok "bbctl runs ($("$BBCTL" --version 2>/dev/null | head -n 1))"; else bad "bbctl does not run: $BBCTL"; fi

    if [ -f "$KAKAO_CREDS" ]; then
        local mode
        mode="$(stat -f '%Lp' "$KAKAO_CREDS" 2>/dev/null || stat -c '%a' "$KAKAO_CREDS" 2>/dev/null || echo '?')"
        if kakao_logged_in; then ok "KakaoTalk credentials present (mode $mode)"; else bad "KakaoTalk credentials file exists but no account is active (kakao-beeper login-kakao)"; fi
    else bad "no KakaoTalk credentials (kakao-beeper login-kakao)"; fi
    if beeper_logged_in; then ok "bbctl signed in to Beeper"; else bad "bbctl not signed in (kakao-beeper login-beeper)"; fi

    if [ -f "$DATA/config.yaml" ]; then
        grep -q 'software: hungry' "$DATA/config.yaml" && ok "config.yaml targets Beeper" || bad "config.yaml is not a Beeper config (kakao-beeper configure)"
        grep -q '^network:' "$DATA/config.yaml" && ok "config.yaml has the network section" || bad "config.yaml lacks the network section (kakao-beeper configure)"
        local cfg_node cfg_sc
        cfg_node="$(sed -n 's/^    node_path: //p' "$DATA/config.yaml" | head -n 1)"
        cfg_sc="$(sed -n 's/^    sidecar_script: //p' "$DATA/config.yaml" | head -n 1)"
        [ -x "${cfg_node:-/nonexistent}" ] && ok "config node_path exists" || bad "config node_path missing: ${cfg_node:-unset} (kakao-beeper configure after deleting the network section, or fix the path)"
        [ -f "${cfg_sc:-/nonexistent}" ] && ok "config sidecar_script exists" || bad "config sidecar_script missing: ${cfg_sc:-unset}"
    else bad "no config.yaml (kakao-beeper setup)"; fi

    if [ -f "$PLIST" ]; then ok "login item installed"; else bad "login item not installed (kakao-beeper enable)"; fi
    if service_loaded; then
        local pid
        pid="$(launchctl print "$DOMAIN/$LABEL" 2>/dev/null | sed -n 's/^[[:space:]]*pid = //p' | head -n 1)"
        if [ -n "$pid" ]; then ok "bridge running (pid $pid)"; else bad "bridge loaded but not running (kakao-beeper logs)"; fi
    else bad "bridge not loaded in launchd (kakao-beeper start)"; fi
    local st
    st="$(session_state)"
    case "$st" in
        CONNECTED*) ok "KakaoTalk session: $st" ;;
        "") say "  --    no bridge state logged yet" ;;
        *BAD_CREDENTIALS*) bad "KakaoTalk session: $st (kakao-beeper login-kakao, then restart)" ;;
        *) bad "KakaoTalk session: $st (see kakao-beeper logs; reconnects on its own when the network is back)" ;;
    esac
    [ -f "$DATA/sh-kakaotalk.db" ] && ok "bridge database present" || say "  --    no bridge database yet (appears after the first start)"
    if [ -f "$DATA/logs/bridge.log" ]; then
        local errs
        errs="$(grep -E '"level":"(error|fatal)"' "$DATA/logs/bridge.log" | tail -n 3 | cut -c1-200)"
        [ -n "$errs" ] && { say "  last errors in bridge.log:"; printf '%s\n' "$errs" | sed 's/^/        /'; }
    fi
    say ""
    if [ "$fails" = 0 ]; then say "all checks passed"; else say "$fails check(s) failed"; return 1; fi
}

cmd_logs() {
    mkdir -p "$DATA/logs"; touch "$DATA/logs/bridge.log" "$DATA/logs/launchd-stderr.log"
    say "Following $DATA/logs (Ctrl+C to stop)"
    tail -n 30 -f "$DATA/logs/bridge.log" "$DATA/logs/launchd-stderr.log"
}

cmd_setup() {
    if kakao_logged_in; then
        say "KakaoTalk: already signed in."
        ask_yes "Sign in again (e.g. a different account)?" n && cmd_login_kakao
    else
        cmd_login_kakao
    fi
    say ""
    if beeper_logged_in; then say "Beeper: already signed in ($("$BBCTL" whoami 2>&1 | head -n 1))."; else cmd_login_beeper; fi
    say ""
    cmd_configure
    cmd_enable
    say ""
    say "== Last step, in Beeper"
    say "Open Beeper Desktop, start a new chat with  $BOT  and send:  login"
    say "Your KakaoTalk chats then appear in Beeper (give it a minute)."
    say "Check on it any time with:  kakao-beeper status     full check-up:  kakao-beeper doctor"
}

cmd_uninstall() {
    say "This removes the bridge from this Mac."
    ask_yes "Continue?" n || exit 0
    cmd_disable
    if beeper_logged_in && ask_yes "Also unregister '$BRIDGE_NAME' from your Beeper account (removes the KakaoTalk chats from Beeper)?" y; then
        "$BBCTL" delete "$BRIDGE_NAME" || say "(bbctl delete failed; you can retry: $BBCTL delete $BRIDGE_NAME)"
    fi
    if kakao_logged_in && ask_yes "Sign the tablet session out of KakaoTalk and delete its credentials?" y; then
        "$NODE" "$KAKAO_CLI" auth logout || true
    fi
    if ask_yes "Delete all bridge data and the program files ($DATA)?" y; then
        rm -rf "$DATA"
        rm -f "$HOME/.local/bin/kakao-beeper"
        say "Removed."
    fi
}

cmd_help() {
    cat <<EOF
kakao-beeper — KakaoTalk in Beeper

  setup          guided: sign in to KakaoTalk and Beeper, configure, start the bridge
  status         is it running and signed in
  doctor         check every part and say what to do about failures
  logs           follow the bridge logs
  restart | stop | start
  login-kakao    sign in to KakaoTalk again
  login-beeper   sign in to Beeper again
  configure      (re)generate the bridge config
  enable | disable   add/remove the login item that keeps the bridge running
  uninstall      remove everything
EOF
}

case "${1:-help}" in
    setup) cmd_setup ;;
    status) cmd_status ;;
    doctor) cmd_doctor ;;
    logs) cmd_logs ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    login-kakao) cmd_login_kakao ;;
    login-beeper) cmd_login_beeper ;;
    configure) cmd_configure ;;
    enable) cmd_enable ;;
    disable) cmd_disable ;;
    uninstall) cmd_uninstall ;;
    help | -h | --help) cmd_help ;;
    *) cmd_help; exit 1 ;;
esac
